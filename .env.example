# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Postgres (used by docker-compose + backend) ---
POSTGRES_USER=mrn
POSTGRES_PASSWORD=change_me
POSTGRES_DB=meridian_relief
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mrn:change_me@localhost:5432/meridian_relief

# --- API ---
PORT=4000
# Local Vite: http://localhost:5173
# Single-container / production SPA: http://localhost:8080 (or your public URL)
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_a_long_random_string

# Optional: host port when running docker compose app service
APP_PORT=8080

# Set to true only when serving over HTTPS (secure session cookie)
COOKIE_SECURE=false

# --- OpenAI (required for skill embeddings / matching) ---
OPENAI_API_KEY=
